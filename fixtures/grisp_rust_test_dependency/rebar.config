{erl_opts, [debug_info]}.
{plugins, [
    {rebar3_cargo, {git, "https://github.com/grisp/rebar3_cargo.git",
                    {branch, "cross_build_support_0_1_1"}}}
]}.
{cargo_opts, [
    {src_dir, "native/grisp_rust_test_dependency_native"},
    {features, ["dependency-probe"]}
]}.
{provider_hooks, [
    {pre, [{compile, {cargo, build}}]},
    {post, [{clean, {cargo, clean}}]}
]}.
