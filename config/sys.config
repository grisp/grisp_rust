[
    {grisp_rust, [
        {testsuite_autostart, true},
        {testsuite_delay_ms, 5000},
        {testsuite_profile, smoke},
        {testsuite_scratch_root, "/tmp"}
    ]},
    {kernel, [
        {logger_level, debug},
        {logger, [
            {handler, default, logger_std_h, #{
                level => debug,
                filter_default => log,
                config => #{type => standard_io},
                formatter => {logger_formatter, #{
                    legacy_header => false,
                    single_line => true
                }}
            }}
        ]}
    ]}

].
