{deps, [
    %grisp,
    {grisp, {git, "https://github.com/grisp/grisp.git", {branch, "sylane/rust-support"}}},
    {grisp_rust_test_dependency, {path, "fixtures/grisp_rust_test_dependency"}},
    {epmd, {git, "https://github.com/erlang/epmd", {ref, "4d1a59"}}}
]}.

{erl_opts, [debug_info]}.

{project_plugins, [
    %rebar3_grisp
    {rebar3_grisp, {git, "https://github.com/grisp/rebar3_grisp.git",
                    {branch, "sylane/rust-support"}}}
]}.

{plugins, [
    {rebar3_cargo, {git, "https://github.com/grisp/rebar3_cargo.git", {branch, "cross_build_support_0_1_1"}}},
    {rebar3_path_deps, "0.4.0"}
]}.

{cargo_opts, [
    {src_dir, "native"}
]}.

{provider_hooks, [
    {pre, [{compile, {cargo, build}}]},
    {post, [{clean, {cargo, clean}}]}
]}.

{grisp, [
    {platform, grisp2},
    {otp, [{version, "29.1.2"}]},
    {build, [{toolchain, [{docker, "grisp/grisp2-rtems-toolchain"}]}]},
    {deploy, [
       {destination, "/Volumes/GRISP"},
       {pre_script, "rm -rf /Volumes/GRISP/*"},
       {post_script, "diskutil umount /Volumes/GRISP"}
    ]}
]}.

{relx, [
    {include_src, false},
    {debug_info, strip},
    %{include_erts, true},
    {dev_mode, false},
    {release, {grisp_rust, "0.1.0"}, [
        runtime_tools,
        {epmd, none},
        grisp,
        grisp_rust
    ]}
]}.

{profiles, [
    {default, [
        {relx, [
            {sys_config, "config/sys.config"}
        ]}
    ]},
    {local, [
        {deps, [
            {grisp_emulation, {git, "git@github.com:grisp/grisp_emulation.git", {branch, master}}}
        ]},
        {shell, [
            {apps, [grisp_emulation, grisp_rust]},
            {config, "config/local.config"}
        ]}
    ]}
]}.
